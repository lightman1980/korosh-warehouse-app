{
  "name": "whatsapp-notification-system",
  "version": "1.0.0",
  "description": "سیستم ارسال هشدارها و پیام‌های واتس‌اپ برای کسب‌وکار",
  "main": "whatsapp-backend.js",
  "scripts": {
    "start": "node whatsapp-backend.js",
    "dev": "nodemon whatsapp-backend.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "build": "echo 'Build completed'",
    "pm2:start": "pm2 start whatsapp-backend.js --name 'whatsapp-api'",
    "pm2:stop": "pm2 stop whatsapp-api",
    "pm2:restart": "pm2 restart whatsapp-api",
    "pm2:logs": "pm2 logs whatsapp-api"
  },
  "keywords": [
    "whatsapp",
    "notification",
    "api",
    "twilio",
    "360dialog",
    "green-api",
    "messaging",
    "alert",
    "persian",
    "farsi"
  ],
  "author": "MiniMax Agent",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "redis": "^4.6.10",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "joi": "^17.11.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.4",
    "cron": "^3.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/whatsapp-notification-system.git"
  },
