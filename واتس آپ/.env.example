# WhatsApp Notification System Environment Configuration
# تنظیمات محیطی سیستم اعلان واتس‌اپ

# Server Configuration
PORT=3001
NODE_ENV=development

# WhatsApp Provider Settings
# تنظیمات سرویس‌دهنده واتس‌اپ

# Option 1: Twilio (Recommended)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
TWILIO_BUSINESS_ACCOUNT_ID=your_business_account_id

# Option 2: 360Dialog
THREESIXTY_API_KEY=your_360dialog_api_key
THREESIXTY_INSTANCE_ID=your_360dialog_instance_id

# Option 3: Green API
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token

# Webhook Configuration
WEBHOOK_URL=https://yourdomain.com/api/webhooks/twilio
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Database Configuration (Optional - Uses in-memory by default)
MONGODB_URI=mongodb://localhost:27017/whatsapp_system
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_jwt_secret_key_here
API_RATE_LIMIT=100
API_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/whatsapp-system.log

# Email Configuration (For notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# Twilio WhatsApp Business API Specific Settings
TWILIO_WHATSAPP_SANDBOX_TOKEN=your_sandbox_token
TWILIO_WHATSAPP_STATUS_CALLBACK=https://yourdomain.com/api/webhooks/status

# 360Dialog Specific Settings
THREESIXTY_WEBHOOK_SECRET=your_webhook_secret
THREESIXTY_SEND_MESSAGE_URL=https://api.360dialog.io/v1/whatsapp/send

# Green API Specific Settings
GREEN_API_WEBHOOK_URL=https://yourdomain.com/api/webhooks/green-api
GREEN_API_RECEIVE_NOTIFICATIONS=true

# Business Settings
BUSINESS_NAME=Your Business Name
BUSINESS_TIMEZONE=Asia/Tehran
BUSINESS_LANGUAGE=fa
BUSINESS_DEFAULT_TEMPLATE=default_message

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Message Settings
MESSAGE_MAX_LENGTH=4096
MESSAGE_RETRY_DELAY=1000
MESSAGE_BATCH_SIZE=10

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Monitoring
HEALTH_CHECK_INTERVAL=30000
MONITORING_ENABLED=true
ALERT_EMAIL=admin@yourdomain.com

# Development Settings
DEBUG_MODE=false
MOCK_SEND=false
LOG_REQUESTS=true

# Production Settings (when NODE_ENV=production)
# PRODUCTION_DOMAIN=https://yourdomain.com
# PRODUCTION_SSL_CERT=/path/to/certificate
# PRODUCTION_SSL_KEY=/path/to/private-key