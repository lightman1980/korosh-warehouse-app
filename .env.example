# ================================================
# Environment Configuration - Software Installer
# Copy this file to .env and customize values
# ================================================

# ================================================
# APPLICATION SETTINGS
# ================================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Application Info
APP_NAME=Software Installer
APP_VERSION=2025.1.0
APP_DESCRIPTION=Automatic Multi-Platform Software Installer

# ================================================
# DATABASE CONFIGURATION
# ================================================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_database
DB_USER=postgres
DB_PASSWORD=secure_password_here
DB_SSL=false

# Connection Pool Settings
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=20000

# ================================================
# DATABASE SPECIFIC SETTINGS
# ================================================

# PostgreSQL Settings
POSTGRES_SSL_MODE=disable
POSTGRES_CONNECT_TIMEOUT=20000
POSTGRES_STATEMENT_TIMEOUT=60000

# MySQL Settings
MYSQL_CONNECTION_TIMEOUT=20000
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_QUEUE_LIMIT=0
MYSQL_ACQUIRE_TIMEOUT=60000

# MongoDB Settings
MONGODB_URL=mongodb://localhost:27017
MONGODB_OPTIONS=--maxPoolSize=10 --serverSelectionTimeoutMS=5000

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_DB=0

# ================================================
# SECURITY SETTINGS
# ================================================

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=86400000

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key-here
HASH_ROUNDS=12

# CORS Settings
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ================================================
# SSL/TLS CONFIGURATION
# ================================================
SSL_ENABLED=true
SSL_CERTIFICATE_PATH=/app/ssl/cert.pem
SSL_PRIVATE_KEY_PATH=/app/ssl/key.pem
SSL_CA_PATH=/app/ssl/ca.pem

# Let's Encrypt (for production)
LETSENCRYPT_EMAIL=your-email@domain.com
LETSENCRYPT_DOMAINS=yourdomain.com,www.yourdomain.com

# ================================================
# LOGGING CONFIGURATION
# ================================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=30

# Enable different log levels for different environments
LOG_LEVEL_DEV=debug
LOG_LEVEL_PROD=info
LOG_LEVEL_TEST=error

# ================================================
# MONITORING & HEALTH CHECKS
# ================================================
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRIES=3

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ================================================
# FILE STORAGE CONFIGURATION
# ================================================

# Local Storage
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
STORAGE_MAX_FILE_SIZE=50MB

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-s3-bucket
AWS_S3_ENDPOINT=

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=/app/config/google-cloud-key.json
GOOGLE_CLOUD_BUCKET_NAME=your-gcs-bucket

# ================================================
# EMAIL CONFIGURATION
# ================================================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Software Installer <noreply@yourdomain.com>

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# ================================================
# NOTIFICATION SETTINGS
# ================================================
NOTIFICATIONS_ENABLED=true
NOTIFICATION_CHANNELS=email,webhook

# Webhook Notifications
WEBHOOK_URL=https://your-webhook-endpoint.com/notifications
WEBHOOK_SECRET=your-webhook-secret

# Push Notifications
PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
PUSH_SUBJECT=mailto:your-email@domain.com

# ================================================
# BACKUP CONFIGURATION
# ================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Cloud Backup
BACKUP_CLOUD_PROVIDER=aws
BACKUP_CLOUD_BUCKET=your-backup-bucket
BACKUP_CLOUD_REGION=us-east-1

# ================================================
# PLATFORM SPECIFIC SETTINGS
# ================================================

# Mobile App Settings
MOBILE_APP_NAME=Software Installer Mobile
MOBILE_APP_PACKAGE=com.company.softwareinstaller
MOBILE_APP_VERSION=1.0.0
MOBILE_BUILD_PATH=/app/mobile-builds

# Desktop App Settings
DESKTOP_APP_NAME=Software Installer Desktop
DESKTOP_APP_VERSION=1.0.0
DESKTOP_BUILD_PATH=/app/desktop-builds

# Cloud Deployment Settings
CLOUD_PROVIDER=aws
KUBERNETES_NAMESPACE=software-installer
HELM_CHART_PATH=/app/helm
HELM_VALUES_PATH=/app/helm/values-production.yaml

# ================================================
# DEVELOPMENT SETTINGS
# ================================================
DEV_PORT=3000
DEV_HOST=localhost
DEV_HOT_RELOAD=true
DEV_SOURCE_MAPS=true
DEV_DEBUG=true

# Database seeding
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# ================================================
# PRODUCTION SETTINGS
# ================================================
PROD_API_BASE_URL=https://api.yourdomain.com
PROD_WEB_BASE_URL=https://yourdomain.com
PROD_CDN_URL=https://cdn.yourdomain.com

# Load Balancer
LOAD_BALANCER_URL=https://lb.yourdomain.com
LOAD_BALANCER_HEALTH_CHECK=/health

# ================================================
# FEATURE FLAGS
# ================================================
FEATURE_MAINTENANCE_MODE=false
FEATURE_REGISTRATION_ENABLED=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_API_DOCUMENTATION=true
FEATURE_ADMIN_PANEL=true

# ================================================
# PERFORMANCE SETTINGS
# ================================================
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_TTL=3600
CACHE_PREFIX=software_installer:

# Connection Pool
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_CREATE_TIMEOUT=30000
DB_POOL_DESTROY_TIMEOUT=5000

# Worker Settings
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS_PER_CHILD=1000

# ================================================
# THIRD-PARTY INTEGRATIONS
# ================================================

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your-new-relic-key
NEW_RELIC_APP_NAME=Software Installer

# ================================================
# DOCKER CONFIGURATION
# ================================================
COMPOSE_PROJECT_NAME=software-installer
COMPOSE_FILE=docker-compose.yml
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your-registry.com

# ================================================
# KUBERNETES CONFIGURATION
# ================================================
KUBECONFIG=~/.kube/config
KUBE_CONTEXT=production
KUBE_NAMESPACE=software-installer
KUBE_SERVICE_ACCOUNT=software-installer

# ================================================
# LOAD TESTING (Development)
# ================================================
LOAD_TEST_ENABLED=false
LOAD_TEST_CONCURRENT_USERS=100
LOAD_TEST_DURATION=300
LOAD_TEST_RAMP_UP=60

# ================================================
# COMPLIANCE & AUDIT
# ================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION=90
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365

# ================================================
# ADVANCED CONFIGURATION
# ================================================

# Clustering
CLUSTER_ENABLED=true
CLUSTER_WORKERS=auto

# Queue Settings
QUEUE_DRIVER=redis
QUEUE_CONNECTION=default
QUEUE_MAX_JOBS=1000
QUEUE_MAX_ATTEMPTS=3

# Cache Settings
CACHE_PREFIX=si_
CACHE_STORE=redis
CACHE_PREFIX_USERS=user:
CACHE_PREFIX_SESSIONS=session:

# ================================================
# NOTES
# ================================================
# 1. Copy this file to .env and customize values
# 2. Never commit .env file to version control
# 3. Use strong passwords and secrets
# 4. Configure SSL for production environments
# 5. Set up proper backup strategies
# 6. Monitor application performance and logs
# 7. Update dependencies regularly
# 8. Use environment-specific configurations