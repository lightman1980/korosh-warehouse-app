  id: string;
  productType: 'owned' | 'consignment';
  productId: string;
  productName: string;
  siteId: string;
  siteName: string;
  tankId: string;
  tankName: string;
  companyId: string;
  companyName: string;
  customerCompanyId?: string;
  customerCompanyName?: string;
  locationId: string;
  locationName: string;
  driverId?: string;
  driverName?: string;
  contractId?: string;
  contractNumber?: string;
  quantity: number; // موجودی فعلی
  lastUpdated: Date;
}

